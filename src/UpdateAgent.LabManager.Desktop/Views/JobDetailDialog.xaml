<Window x:Class="UpdateAgent.LabManager.Desktop.Views.JobDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="작업 상세" Height="720" Width="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="상태" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StateText" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="진행" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ProgressText" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="항목" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ItemsText" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="재부팅" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RebootText" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="메시지" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="MessageText" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="시작" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="StartedText" />
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="갱신" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="UpdatedText" />
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="오류" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="ErrorText"
                                       Foreground="#DC2626" TextWrapping="Wrap" />
                        </Grid>
                        <ProgressBar x:Name="ProgressBar" Height="10" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="업데이트 항목" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
                <ListBox x:Name="ItemsList" BorderBrush="#E5E7EB" MaxHeight="180">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Kb}" FontFamily="Consolas" FontSize="12"
                                               Foreground="#2563EB" />
                                    <TextBlock Text="{Binding Title}" Margin="8,0,0,0" FontSize="12" />
                                    <TextBlock Text="{Binding State}" Margin="8,0,0,0" FontSize="12"
                                               Foreground="{Binding StateBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Error}" FontSize="11" Foreground="#DC2626"
                                           Visibility="{Binding ErrorVisibility}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="사전 점검" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
                <ListBox x:Name="ChecksList" BorderBrush="#E5E7EB" MaxHeight="160">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4" Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{Binding StateBrush}" Width="180" />
                                <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Maestro 수동 확인" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock x:Name="MaestroInfoText" TextWrapping="Wrap" FontSize="12" />
                        <StackPanel x:Name="MaestroAlert" Margin="0,10,0,0" Visibility="Collapsed"
                                    Background="#FEF2F2">
                            <TextBlock Text="재부팅 후 마커가 사라졌습니다. Maestro 복원이 아직 켜져 있을 수 있습니다."
                                       Foreground="#B91C1C" TextWrapping="Wrap" Margin="8" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="ProtectionButton" Content="보호 해제 확인" Width="120"
                                    Style="{StaticResource ToolbarButton}" Click="Protection_Click" />
                            <Button x:Name="RestoredButton" Content="상태 저장 + 보호 재활성화 확인"
                                    Width="200" Margin="8,0,0,0" Style="{StaticResource ToolbarButton}"
                                    Click="Restored_Click" />
                        </StackPanel>
                        <TextBlock x:Name="BeforeGuide" Style="{StaticResource MutedText}"
                                   Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBlock x:Name="AfterGuide" Style="{StaticResource MutedText}"
                                   Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="닫기" Width="90" Style="{StaticResource ToolbarButton}" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
