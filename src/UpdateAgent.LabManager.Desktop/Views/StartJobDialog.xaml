<Window x:Class="UpdateAgent.LabManager.Desktop.Views.StartJobDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="업데이트 작업 시작" Height="600" Width="560"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold">
            <Run Text="대상 PC: " />
            <Run x:Name="TargetCountText" Text="0대" Foreground="#2563EB" />
        </TextBlock>

        <TextBlock Grid.Row="1" Margin="0,12,0,0" Text="업데이트 분류" FontSize="13" FontWeight="SemiBold" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Padding="14">
                    <StackPanel>
                        <CheckBox x:Name="SecurityCheck" Content="보안 업데이트" IsChecked="True" Margin="0,3" />
                        <CheckBox x:Name="CriticalCheck" Content="중요 업데이트" IsChecked="True" Margin="0,3" />
                        <CheckBox x:Name="ImportantCheck" Content="필요 업데이트" IsChecked="True" Margin="0,3" />
                        <CheckBox x:Name="OptionalCheck" Content="선택(권장) 업데이트" Margin="0,3" />
                        <CheckBox x:Name="DriversCheck" Content="드라이버 업데이트" Margin="0,3" />
                        <CheckBox x:Name="DefinitionsCheck" Content="정의 업데이트(Defender 등)" Margin="0,3" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="작업 동작" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="최대 재부팅 횟수" Width="140" VerticalAlignment="Center"
                                       Style="{StaticResource MutedText}" />
                            <TextBox x:Name="MaxRebootsBox" Text="5" Width="60" Height="26"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                        <CheckBox x:Name="PauseOnUserCheck" Content="사용자가 로그온하면 일시중지" IsChecked="True" Margin="0,6,0,3" />
                        <CheckBox x:Name="OverlayCheck" Content="전체화면 진행 오버레이 사용" IsChecked="True" Margin="0,3" />
                        <CheckBox x:Name="RebootNeverCheck" Content="자동 재부팅하지 않음(수동)" Margin="0,3" />
                    </StackPanel>
                </Border>

                <Border x:Name="MaestroBlock" Style="{StaticResource CardBorder}" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Maestro Network 7 확인" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#B45309" Margin="0,0,0,8" />
                        <TextBlock Text="작업 전 Maestro의 복원 보호를 수동/해제로 전환했는지 확인하세요."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                        <CheckBox x:Name="MaestroConfirmCheck" Margin="0,10,0,0"
                                  Content="Maestro 복원 보호 해제를 확인했습니다" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="메모(선택)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBox x:Name="NoteBox" Height="56" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" x:Name="WarningText" Margin="0,10,0,0" Foreground="#DC2626"
                   FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="취소" Width="80" Margin="0,0,8,0" Style="{StaticResource ToolbarButton}"
                    Click="Cancel_Click" />
            <Button x:Name="SubmitButton" Content="작업 시작" Width="110" Style="{StaticResource PrimaryButton}"
                    Click="Submit_Click" />
        </StackPanel>
    </Grid>
</Window>
