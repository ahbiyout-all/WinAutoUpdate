<Window x:Class="UpdateAgent.LabManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UpdateAgent · 교사 관리 콘솔" Height="820" Width="1320"
        MinHeight="600" MinWidth="980"
        WindowStartupLocation="Manual" Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#2563EB">
                        <TextBlock Text="UA" Foreground="White" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="UpdateAgent" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="교사 관리 콘솔 · Maestro 수동 모드" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <Button x:Name="VersionButton" Margin="14,0,0,0" Style="{StaticResource ToolbarButton}"
                            Click="Version_Click" ToolTip="GitHub Releases에서 최신 버전 확인">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="VersionText" Text="v?" FontFamily="Consolas" FontSize="12" />
                            <Ellipse x:Name="UpdateDot" Width="8" Height="8" Margin="6,0,0,0"
                                     Fill="#DC2626" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedCountText" VerticalAlignment="Center" Margin="0,0,12,0"
                               Style="{StaticResource MutedText}" />
                    <Button x:Name="RefreshButton" Content="새로고침" Style="{StaticResource ToolbarButton}"
                            Click="Refresh_Click" />
                    <Button x:Name="TokenButton" Content="토큰" Margin="8,0,0,0" Style="{StaticResource ToolbarButton}"
                            Click="Token_Click" />
                    <Button x:Name="StartButton" Content="업데이트 작업 시작" Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButton}" Click="Start_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 오류 배너 -->
        <Border x:Name="ErrorBar" Grid.Row="1" Background="#FEF2F2" BorderBrush="#FECACA"
                BorderThickness="0,0,0,1" Padding="18,8" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- 요약 카드 -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="18,14,18,0">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="등록된 PC" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="AgentCountText" FontSize="26" FontWeight="SemiBold" Foreground="#2563EB" />
                    <TextBlock x:Name="OnlineCountText" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Text="작업 중" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="ActiveJobsText" FontSize="26" FontWeight="SemiBold" Foreground="#D97706" />
                    <TextBlock x:Name="BusyCountText" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Text="완료" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="CompletedJobsText" FontSize="26" FontWeight="SemiBold" Foreground="#059669" />
                    <TextBlock Text="누적 작업" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="실패" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="FailedJobsText" FontSize="26" FontWeight="SemiBold" Foreground="#DC2626" />
                    <TextBlock Text="확인 필요" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 메인 탭 -->
        <TabControl Grid.Row="3" Margin="18,14,18,18" Background="Transparent" BorderThickness="0">
            <TabItem Header="학생 PC">
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="0,0,8,8">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Margin="6,4,0,8" Style="{StaticResource MutedText}"
                                   Text="체크박스로 작업 대상 PC를 선택하세요. 오프라인 PC는 WoL로 깨운 뒤 작업을 배정할 수 있습니다." />
                        <DataGrid Grid.Row="1" x:Name="AgentsGrid" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" RowHeight="58" FontSize="12"
                                  BorderThickness="0" Background="Transparent"
                                  SelectionMode="Single" SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="42">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="PC 이름" Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MachineName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SubText}" Style="{StaticResource MutedText}"
                                                           FontFamily="Consolas" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="상태" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Tags}" Style="{StaticResource MutedText}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="현재 작업" Width="210">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding JobText}" Foreground="{Binding JobBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Height="4" Value="{Binding JobProgress, Mode=OneWay}" Minimum="0" Maximum="100" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="운영체제" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding OsText}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding OsVersion}" Style="{StaticResource MutedText}" />
                                                <TextBlock Text="Maestro 감지됨" Foreground="#B45309" FontSize="11"
                                                           Visibility="{Binding MaestroInstalled, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="여유 공간" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FreeDiskText}" />
                                                <TextBlock Text="{Binding DeviceText}" Style="{StaticResource MutedText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="마지막 신호" Binding="{Binding SeenText}" Width="100" />
                                <DataGridTemplateColumn Header="작업" Width="260">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="WoL" Style="{StaticResource MiniButton}"
                                                        Click="Wake_Click" />
                                                <Button Content="업데이트" Style="{StaticResource MiniButton}"
                                                        Margin="4,0,0,0" Click="AgentStart_Click" />
                                                <Button Content="해제" Style="{StaticResource MiniButton}"
                                                        Margin="4,0,0,0" Click="Unlock_Click" />
                                                <Button Content="재부팅" Style="{StaticResource MiniButton}"
                                                        Margin="4,0,0,0" Click="Reboot_Click" />
                                                <Button Content="종료" Style="{StaticResource MiniButton}"
                                                        Margin="4,0,0,0" Click="Shutdown_Click" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="업데이트 작업">
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="0,0,8,8">
                    <DataGrid x:Name="JobsGrid" Margin="8" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeight="58" FontSize="12" BorderThickness="0" Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="PC / 작업 ID" Width="230">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MachineName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding JobId}" Style="{StaticResource MutedText}"
                                                       FontFamily="Consolas" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="상태" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateBrush}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Phase}" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="진행" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <ProgressBar Height="8" Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="100" />
                                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="재부팅" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RebootText}" />
                                            <TextBlock Text="{Binding MaestroText}" Foreground="#B45309" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="갱신" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UpdatedText}" />
                                            <TextBlock Text="{Binding UpdatedAgo}" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="작업" Width="270">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="상세" Style="{StaticResource MiniButton}"
                                                    Click="JobDetail_Click" />
                                            <Button x:Name="PauseButton" Content="일시중지" Margin="4,0,0,0"
                                                    Style="{StaticResource MiniButton}" Click="JobAction_Click"
                                                    Visibility="{Binding IsTerminal, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <Button Content="재개" Margin="4,0,0,0" Style="{StaticResource MiniButton}"
                                                    Click="JobResume_Click"
                                                    Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="취소" Margin="4,0,0,0" Style="{StaticResource MiniButton}"
                                                    Click="JobCancel_Click"
                                                    Visibility="{Binding IsTerminal, Converter={StaticResource InverseBoolToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <TabItem Header="감사 로그">
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="0,0,8,8">
                    <ListBox x:Name="AuditList" Margin="8" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                               Style="{StaticResource MutedText}" FontFamily="Consolas" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </TabItem>
        </TabControl>

        <!-- 토스트 -->
        <Border x:Name="ToastBorder" Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,28,28" Padding="16,12" CornerRadius="8" Background="#1F2937"
                Visibility="Collapsed" Panel.ZIndex="10" MaxWidth="420">
            <TextBlock x:Name="ToastText" Text="" Foreground="White" FontSize="13" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
