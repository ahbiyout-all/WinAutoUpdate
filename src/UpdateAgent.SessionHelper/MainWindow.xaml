<Window x:Class="UpdateAgent.SessionHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows 업데이트 진행"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        Foreground="#F5F8FF"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI, Malgun Gothic"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid x:Name="RootGrid" Background="Black">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="620"
                    TextOptions.TextFormattingMode="Display">

            <TextBlock Text="WINDOWS UPDATE"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#5F7FA6"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,14" />

            <TextBlock x:Name="PhaseText"
                       Text="{Binding Phase}"
                       FontSize="26"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6" />

            <TextBlock Text="{Binding PercentText}"
                       FontSize="64"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{Binding Accent}"
                       Margin="0,0,0,4" />

            <ProgressBar Style="{StaticResource OverlayProgress}"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding ProgressValue, Mode=OneWay}"
                         Margin="0,0,0,18" />

            <TextBlock Text="{Binding KbLabel}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#BFD3EE"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,6" />

            <TextBlock Text="{Binding Message}"
                       FontSize="14"
                       Foreground="#8195AD"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="560"
                       Margin="0,0,0,22" />

            <Border Background="#121A26"
                    BorderBrush="#23324A"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,12">
                <StackPanel>
                    <TextBlock Text="{Binding DetailText}"
                               FontSize="13"
                               Foreground="#9FB2C9"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RebootText}"
                               FontSize="13"
                               Foreground="#F0B75A"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="{Binding RebootVisibility}" />
                </StackPanel>
            </Border>

            <TextBlock Text="PC 전원을 끄거나 전원 케이블을 분리하지 마세요. 업데이트 중 자동으로 재부팅될 수 있습니다."
                       FontSize="12"
                       Foreground="#51637A"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="560"
                       Margin="0,20,0,0" />

            <TextBlock x:Name="SessionText"
                       FontSize="10"
                       Foreground="#2C3A4C"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0" />
        </StackPanel>
    </Grid>
</Window>
