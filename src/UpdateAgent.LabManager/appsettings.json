{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LabManager": {
    "AdminToken": "sample-admin-token-replace-before-pilot",
    "AgentToken": "sample-agent-token-replace-before-pilot",
    "AllowDefaultTokens": false,
    "OnlineThresholdSeconds": 90,
    "WakePorts": [9, 7],
    "WakeRepeatCount": 3
  },
  "Urls": "http://0.0.0.0:5080"
}
