{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LabManager": {
    "AdminToken": "change-me-admin-token",
    "AgentToken": "change-me-agent-token",
    "AllowDefaultTokens": false,
    "OnlineThresholdSeconds": 90,
    "WakePorts": [9, 7],
    "WakeRepeatCount": 3
  },
  "Urls": "http://0.0.0.0:5080"
}
