<Window x:Class="UpdateAgent.Agent.Desktop.ManualUpdateOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="수동 업데이트 옵션" Height="620" Width="520"
        MinHeight="520" MinWidth="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="수동 업데이트 옵션 선택" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="OsText" Text="" Foreground="#666666" Margin="0,4,0,0" />
            <TextBlock Text="설치 중 입력이 잠기고 PC가 여러 번 재부팅될 수 있습니다."
                       Foreground="#9A6700" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="교사 정책에서 허용되지 않은 항목은 선택해도 적용되지 않습니다."
                       Foreground="#666666" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="OS별 업데이트 프리셋" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <ComboBox x:Name="PresetCombo" Height="28" />
                        <TextBlock x:Name="PresetHintText" Text="" Foreground="#666666"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="업데이트 범위" Padding="10" Margin="0,0,0,10">
                    <WrapPanel>
                        <CheckBox x:Name="SecurityCheck" Content="보안 업데이트" Margin="0,0,12,6" />
                        <CheckBox x:Name="CriticalCheck" Content="중요 업데이트" Margin="0,0,12,6" />
                        <CheckBox x:Name="ImportantCheck" Content="권장 업데이트" Margin="0,0,12,6" />
                        <CheckBox x:Name="OptionalCheck" Content="선택적 업데이트" Margin="0,0,12,6" />
                        <CheckBox x:Name="DriversCheck" Content="드라이버 (기본 제외)" Margin="0,0,12,6" />
                        <CheckBox x:Name="DefinitionsCheck" Content="Defender 정의 업데이트" Margin="0,0,12,6" />
                        <CheckBox x:Name="FeatureCheck" Content="기능 업데이트 (2차 승인 전용)"
                                  IsChecked="False" IsEnabled="False" Margin="0,0,12,6" />
                    </WrapPanel>
                </GroupBox>

                <GroupBox Header="동작" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="OverlayCheck" Content="전체화면 진행 오버레이" />
                        <CheckBox x:Name="NoRebootCheck" Content="자동 재부팅 안 함 (수동)" Margin="0,6,0,0" />
                        <TextBlock Text="최대 재부팅 횟수" Margin="0,8,0,2" />
                        <ComboBox x:Name="MaxRebootsCombo" Width="100" Height="28" HorizontalAlignment="Left" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Maestro 복원 보호 해제 확인" Padding="10">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Text="1. Maestro Network 7에서 '매 부팅 자동 복구'를 '수동 복구/해제'로 전환합니다.&#x0a;2. 이 단계를 건너뛰면 재부팅 후 설치된 업데이트가 사라집니다.&#x0a;3. 작업 중 Maestro의 Windows Update 기능은 수동으로 실행하지 마세요." />
                        <CheckBox x:Name="MaestroCheck"
                                  Content="위 절차를 완료했고 Maestro 복원 보호가 해제된 것을 확인했습니다."
                                  Margin="0,8,0,0" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="ValidationText" Grid.Row="2" Text="" Foreground="#C00000"
                   TextWrapping="Wrap" Margin="0,8,0,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="StartButton" Content="업데이트 시작" Width="110" Height="32"
                    Margin="0,0,8,0" IsDefault="True" Click="StartButton_Click" />
            <Button Content="취소" Width="90" Height="32" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
