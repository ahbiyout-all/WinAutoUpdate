<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.20</ProductVersion>
    <PublishRoot Condition="'$(PublishRoot)' == ''">$(MSBuildThisFileDirectory)..\..\publish</PublishRoot>
    <NoticeRtf>$(MSBuildThisFileDirectory)payload\notice.ko.rtf</NoticeRtf>
    <OutputName>UpdateAgent.Agent-$(ProductVersion)-x64</OutputName>
    <!-- ko-KR.wxl이 있으면 WiX가 문화권별 하위 폴더를 만든다. 단일 한국어 MSI만 만들도록 고정한다. -->
    <Cultures>ko-KR</Cultures>
    <!-- .NET 호스트 exe는 Language=0(중립)이라 ICE60이 발생한다. 실제 문제가 아니므로 억제한다. -->
    <SuppressIces>ICE60</SuppressIces>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishRoot=$(PublishRoot);NoticeRtf=$(NoticeRtf)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Firewall.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
