<?xml version="1.0" encoding="utf-8"?>
<!--
  WixUI_Minimal 한국어 번역.

  WiX 5.0.2의 UI 확장은 en-US 문자열만 포함하므로, MSI 다이얼로그를 한국어로
  표시하려면 이 파일처럼 같은 String Id를 ko-KR 문화권으로 재정의해야 한다.
  {\WixUI_Font_*} 접두사는 다이얼로그 서식이므로 반드시 유지한다.
-->
<WixLocalization Culture="ko-KR"
                 Codepage="949"
                 xmlns="http://wixtoolset.org/schemas/v4/wxl">

  <!-- 공용 단추 -->
  <String Id="WixUIBack" Overridable="yes" Value="뒤로(&amp;B)" />
  <String Id="WixUINext" Overridable="yes" Value="다음(&amp;N)" />
  <String Id="WixUICancel" Overridable="yes" Value="취소" />
  <String Id="WixUIFinish" Overridable="yes" Value="마침(&amp;F)" />
  <String Id="WixUIRetry" Overridable="yes" Value="다시 시도(&amp;R)" />
  <String Id="WixUIIgnore" Overridable="yes" Value="무시(&amp;I)" />
  <String Id="WixUIYes" Overridable="yes" Value="예(&amp;Y)" />
  <String Id="WixUINo" Overridable="yes" Value="아니요(&amp;N)" />
  <String Id="WixUIOK" Overridable="yes" Value="확인" />
  <String Id="WixUIPrint" Overridable="yes" Value="인쇄(&amp;P)" />

  <!-- 준비 -->
  <String Id="PrepareDlg_Title" Overridable="yes" Value="[ProductName] 설치" />
  <String Id="PrepareDlgBitmap" Overridable="yes" Value="WixUI_Bmp_Dialog" />
  <String Id="PrepareDlgDescription" Overridable="yes" Value="설치 마법사가 설치를 준비하는 동안 잠시 기다려 주세요." />
  <String Id="PrepareDlgTitle" Overridable="yes" Value="{\WixUI_Font_Bigger}[ProductName] 설치 마법사에 오신 것을 환영합니다" />

  <!-- 사용권 계약 -->
  <String Id="WelcomeEulaDlg_Title" Overridable="yes" Value="[ProductName] 설치" />
  <String Id="WelcomeEulaDlgBitmap" Overridable="yes" Value="WixUI_Bmp_Dialog" />
  <String Id="WelcomeEulaDlgLicenseAcceptedCheckBox" Overridable="yes" Value="사용권 계약에 동의합니다(&amp;A)" />
  <String Id="WelcomeEulaDlgInstall" Overridable="yes" Value="설치(&amp;I)" />
  <String Id="WelcomeEulaDlgUpdate" Overridable="yes" Value="업데이트(&amp;U)" />
  <String Id="WelcomeEulaDlgTitle" Overridable="yes" Value="{\WixUI_Font_Title}[ProductName] 사용권 계약을 읽어 주세요" />

  <!-- 진행 -->
  <String Id="ProgressDlg_Title" Overridable="yes" Value="[ProductName] 설치" />
  <String Id="ProgressDlgBannerBitmap" Overridable="yes" Value="WixUI_Bmp_Banner" />
  <String Id="ProgressDlgTextInstalling" Overridable="yes" Value="설치 마법사가 [ProductName]을(를) 설치하는 동안 잠시 기다려 주세요." />
