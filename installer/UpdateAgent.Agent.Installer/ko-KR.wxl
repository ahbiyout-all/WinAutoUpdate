  <String Id="ProgressDlgTitleRepairing" Overridable="yes" Value="{\WixUI_Font_Title}[ProductName] 복구 중" />
  <String Id="ProgressDlgTextRemoving" Overridable="yes" Value="설치 마법사가 [ProductName]을(를) 제거하는 동안 잠시 기다려 주세요." />
  <String Id="ProgressDlgTitleRemoving" Overridable="yes" Value="{\WixUI_Font_Title}[ProductName] 제거 중" />
  <String Id="ProgressDlgTextUpdating" Overridable="yes" Value="설치 마법사가 [ProductName]을(를) 업데이트하는 동안 잠시 기다려 주세요." />
