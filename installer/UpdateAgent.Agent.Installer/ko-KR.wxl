  <String Id="ProgressDlgProgressBar" Overridable="yes" Value="진행률" />
  <String Id="ProgressDlgStatusLabel" Overridable="yes" Value="상태:" />

  <!-- 완료 -->
  <String Id="ExitDialog_Title" Overridable="yes" Value="[ProductName] 설치" />
  <String Id="ExitDialogBitmap" Overridable="yes" Value="WixUI_Bmp_Dialog" />
  <String Id="ExitDialogDescription" Overridable="yes" Value="마침 버튼을 눌러 설치 마법사를 종료합니다." />
  <String Id="ExitDialogTitle" Overridable="yes" Value="{\WixUI_Font_Bigger}[ProductName] 설치 마법사를 완료했습니다" />

  <!-- 취소/오류 -->
  <String Id="CancelDlg_Title" Overridable="yes" Value="[ProductName] 설치" />
  <String Id="CancelDlgText" Overridable="yes" Value="[ProductName] 설치를 취소하시겠습니까?" />
  <String Id="CancelDlgIcon" Overridable="yes" Value="WixUI_Ico_Info" />
  <String Id="CancelDlgIconTooltip" Overridable="yes" Value="정보 아이콘" />

  <String Id="ErrorDlg_Title" Overridable="yes" Value="[ProductName] 설치" />
  <String Id="ErrorDlgErrorText" Overridable="yes" Value="정보" />
  <String Id="ErrorDlgErrorIcon" Overridable="yes" Value="WixUI_Ico_Info" />
  <String Id="ErrorDlgErrorIconTooltip" Overridable="yes" Value="정보 아이콘" />

  <String Id="UserExit_Title" Overridable="yes" Value="[ProductName] 설치" />
  <String Id="UserExitBitmap" Overridable="yes" Value="WixUI_Bmp_Dialog" />
  <String Id="UserExitTitle" Overridable="yes" Value="{\WixUI_Font_Bigger}[ProductName] 설치 마법사가 중단되었습니다" />
  <String Id="UserExitDescription1" Overridable="yes" Value="[ProductName] 설치가 중단되었습니다. 시스템은 변경되지 않았습니다. 나중에 이 프로그램을 설치하려면 설치를 다시 실행하세요." />
  <String Id="UserExitDescription2" Overridable="yes" Value="마침 버튼을 눌러 설치 마법사를 종료합니다." />

  <String Id="FatalError_Title" Overridable="yes" Value="[ProductName] 설치" />
  <String Id="FatalErrorBitmap" Overridable="yes" Value="WixUI_Bmp_Dialog" />
  <String Id="FatalErrorTitle" Overridable="yes" Value="{\WixUI_Font_Bigger}[ProductName] 설치 마법사가 오류로 중단되었습니다" />
  <String Id="FatalErrorDescription1" Overridable="yes" Value="오류 때문에 [ProductName] 설치 마법사가 중단되었습니다. 시스템은 변경되지 않았습니다. 나중에 이 프로그램을 설치하려면 설치 마법사를 다시 실행하세요." />
  <String Id="FatalErrorDescription2" Overridable="yes" Value="마침 버튼을 눌러 설치 마법사를 종료합니다." />

  <!-- 파일 사용 중 -->
  <String Id="FilesInUse_Title" Overridable="yes" Value="[ProductName] 설치" />
  <String Id="FilesInUseExit" Overridable="yes" Value="종료(&amp;X)" />
  <String Id="FilesInUseBannerBitmap" Overridable="yes" Value="WixUI_Bmp_Banner" />
  <String Id="FilesInUseText" Overridable="yes" Value="다음 응용 프로그램이 이 설치에서 업데이트해야 하는 파일을 사용하고 있습니다. 해당 응용 프로그램을 닫은 다음 &quot;다시 시도&quot;를 눌러 설치를 계속하거나 &quot;종료&quot;를 눌러 설치를 끝내세요." />
  <String Id="FilesInUseDescription" Overridable="yes" Value="업데이트해야 하는 일부 파일이 현재 사용 중입니다." />
  <String Id="FilesInUseTitle" Overridable="yes" Value="{\WixUI_Font_Title}파일 사용 중" />

  <String Id="MsiRMFilesInUse_Title" Overridable="yes" Value="[ProductName] 설치" />
  <String Id="MsiRMFilesInUseBannerBitmap" Overridable="yes" Value="WixUI_Bmp_Banner" />
  <String Id="MsiRMFilesInUseText" Overridable="yes" Value="다음 응용 프로그램이 이 설치에서 업데이트해야 하는 파일을 사용하고 있습니다. 설치 마법사가 해당 응용 프로그램을 닫고 다시 시작하도록 하거나, 나중에 컴퓨터를 다시 부팅할 수 있습니다." />
  <String Id="MsiRMFilesInUseDescription" Overridable="yes" Value="업데이트해야 하는 일부 파일이 현재 사용 중입니다." />
  <String Id="MsiRMFilesInUseTitle" Overridable="yes" Value="{\WixUI_Font_Title}파일 사용 중" />
  <String Id="MsiRMFilesInUseUseRM" Overridable="yes" Value="응용 프로그램을 닫고 다시 시작합니다(&amp;C)." />
  <String Id="MsiRMFilesInUseDontUseRM" Overridable="yes" Value="응용 프로그램을 닫지 않습니다. 컴퓨터를 다시 부팅해야 합니다(&amp;D)." />

  <!-- 디스크 공간 -->
  <String Id="OutOfDiskDlg_Title" Overridable="yes" Value="[ProductName] 설치" />
  <String Id="OutOfDiskDlgBannerBitmap" Overridable="yes" Value="WixUI_Bmp_Banner" />
  <String Id="OutOfDiskDlgText" Overridable="yes" Value="강조 표시된 볼륨에 현재 선택한 기능을 설치할 디스크 공간이 부족합니다. 해당 볼륨의 파일을 일부 삭제하거나, 설치할 기능 수를 줄이거나, 다른 대상 드라이브를 선택하세요." />
  <String Id="OutOfDiskDlgDescription" Overridable="yes" Value="설치에 필요한 디스크 공간이 사용 가능한 공간을 초과합니다." />
  <String Id="OutOfDiskDlgTitle" Overridable="yes" Value="{\WixUI_Font_Title}디스크 공간 부족" />
  <String Id="OutOfDiskDlgVolumeList" Overridable="yes" Value="{120}{70}{70}{70}{70}" />

  <String Id="OutOfRbDiskDlg_Title" Overridable="yes" Value="[ProductName] 설치" />
  <String Id="OutOfRbDiskDlgBannerBitmap" Overridable="yes" Value="WixUI_Bmp_Banner" />
  <String Id="OutOfRbDiskDlgText" Overridable="yes" Value="강조 표시된 볼륨에 현재 선택한 기능을 설치할 디스크 공간이 부족합니다. 해당 볼륨의 파일을 일부 삭제하거나, 설치할 기능 수를 줄이거나, 다른 대상 드라이브를 선택하세요." />
  <String Id="OutOfRbDiskDlgDescription" Overridable="yes" Value="설치에 필요한 디스크 공간이 사용 가능한 공간을 초과합니다." />
  <String Id="OutOfRbDiskDlgTitle" Overridable="yes" Value="{\WixUI_Font_Title}디스크 공간 부족" />
  <String Id="OutOfRbDiskDlgVolumeList" Overridable="yes" Value="{120}{70}{70}{70}{70}" />
  <String Id="OutOfRbDiskDlgText2" Overridable="yes" Value="또는 설치 관리자의 롤백 기능을 사용하지 않도록 선택할 수 있습니다. 롤백을 사용하지 않으면 설치가 중단될 때 컴퓨터가 원래 상태로 복원되지 않습니다. 롤백을 사용하지 않을 위험을 감수하려면 &quot;예&quot;를 누르세요." />

