<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:firewall="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <Package Name="UpdateAgent Agent"
           Manufacturer="AhBiYout"
           Version="$(var.ProductVersion)"
           UpgradeCode="58D1BA8F-C2D1-4A36-B944-063870B8F361"
           Scope="perMachine"
           Language="1042"
           InstallerVersion="500"
           Compressed="yes">

    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of UpdateAgent Agent is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AgentIcon" SourceFile="..\..\assets\icons\UpdateAgent.Agent.ico" />
    <Property Id="ARPPRODUCTICON" Value="AgentIcon" />

    <Launch Condition="VersionNT64" Message="UpdateAgent requires 64-bit Windows." />
    <Launch Condition="VersionNT &gt;= 1000" Message="UpdateAgent requires Windows 10 or later." />

    <ui:WixUI Id="WixUI_Minimal" />
    <UIRef Id="UpdateAgentDialogs" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.NoticeRtf)" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="UpdateAgent">
        <Directory Id="ServiceDir" Name="Service" />
        <Directory Id="SessionHelperDir" Name="SessionHelper" />
        <Directory Id="DesktopDir" Name="Desktop" />
        <Directory Id="CliDir" Name="Cli" />
      </Directory>
    </StandardDirectory>

    <Feature Id="AgentFeature" Title="UpdateAgent Agent" Level="1">
      <ComponentGroupRef Id="ServiceFiles" />
      <ComponentGroupRef Id="SessionHelperFiles" />
      <ComponentGroupRef Id="DesktopFiles" />
    </Feature>

    <Feature Id="CliFeature" Title="Command-line tool" Level="2">
      <ComponentGroupRef Id="CliFiles" />
    </Feature>

    <ComponentGroup Id="ServiceFiles" Directory="ServiceDir">
      <Files Include="$(var.PublishRoot)\agent\service\**">
        <Exclude Files="$(var.PublishRoot)\agent\service\UpdateAgent.Service.exe" />
        <Exclude Files="$(var.PublishRoot)\agent\service\appsettings.json" />
        <Exclude Files="$(var.PublishRoot)\agent\service\appsettings.Development.json" />
        <Exclude Files="$(var.PublishRoot)\agent\service\**\*.pdb" />
        <Exclude Files="$(var.PublishRoot)\agent\service\**\*.xml" />
        <Exclude Files="$(var.PublishRoot)\agent\service\**\*.md" />
        <Exclude Files="$(var.PublishRoot)\agent\service\**\*.txt" />
        <Exclude Files="$(var.PublishRoot)\agent\service\**\*.pdf" />
      </Files>

      <Component Id="AgentServiceComponent" Guid="*">
        <File Id="AgentServiceExe"
              Source="$(var.PublishRoot)\agent\service\UpdateAgent.Service.exe"
              KeyPath="yes" />
        <File Id="AgentServiceAppSettings"
              Source="$(var.PublishRoot)\agent\service\appsettings.json" />

        <ServiceInstall Id="AgentServiceInstall"
                        Name="UpdateAgentService"
                        DisplayName="UpdateAgent Service"
                        Description="Windows Update automation agent for computer labs"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem">
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="60"
                              ResetPeriodInDays="1" />
        </ServiceInstall>

        <ServiceControl Id="AgentServiceControl"
                        Name="UpdateAgentService"
                        Stop="both"
                        Remove="uninstall"
                        Start="install"
                        Wait="yes" />

        <!-- 방화벽 규칙을 조용히 등록한다. 기본 이름과 버전이 붙은 이름을 함께 만든다. -->
        <firewall:FirewallException Id="FirewallRuleDefaultName"
                                    Name="UpdateAgent Agent"
                                    File="AgentServiceExe"
                                    Profile="all"
                                    Scope="any"
                                    Grouping="UpdateAgent"
                                    Description="UpdateAgent Service (all networks)" />
        <firewall:FirewallException Id="FirewallRuleVersionedName"
                                    Name="UpdateAgent Agent $(var.ProductVersion)"
                                    File="AgentServiceExe"
                                    Profile="all"
                                    Scope="any"
                                    Grouping="UpdateAgent"
                                    Description="UpdateAgent Service (versioned rule)" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="SessionHelperFiles" Directory="SessionHelperDir">
      <Files Include="$(var.PublishRoot)\agent\sessionhelper\**">
        <Exclude Files="$(var.PublishRoot)\agent\sessionhelper\**\*.pdb" />
        <Exclude Files="$(var.PublishRoot)\agent\sessionhelper\**\*.xml" />
        <Exclude Files="$(var.PublishRoot)\agent\sessionhelper\**\*.md" />
        <Exclude Files="$(var.PublishRoot)\agent\sessionhelper\**\*.txt" />
        <Exclude Files="$(var.PublishRoot)\agent\sessionhelper\**\*.pdf" />
      </Files>
    </ComponentGroup>

    <ComponentGroup Id="DesktopFiles" Directory="DesktopDir">
      <Files Include="$(var.PublishRoot)\agent\desktop\**">
        <Exclude Files="$(var.PublishRoot)\agent\desktop\**\*.pdb" />
        <Exclude Files="$(var.PublishRoot)\agent\desktop\**\*.xml" />
        <Exclude Files="$(var.PublishRoot)\agent\desktop\**\*.md" />
        <Exclude Files="$(var.PublishRoot)\agent\desktop\**\*.txt" />
        <Exclude Files="$(var.PublishRoot)\agent\desktop\**\*.pdf" />
      </Files>
    </ComponentGroup>

    <ComponentGroup Id="CliFiles" Directory="CliDir">
      <Files Include="$(var.PublishRoot)\cli\**">
        <Exclude Files="$(var.PublishRoot)\cli\**\*.pdb" />
        <Exclude Files="$(var.PublishRoot)\cli\**\*.xml" />
        <Exclude Files="$(var.PublishRoot)\cli\**\*.md" />
        <Exclude Files="$(var.PublishRoot)\cli\**\*.txt" />
        <Exclude Files="$(var.PublishRoot)\cli\**\*.pdf" />
      </Files>
    </ComponentGroup>

  </Package>
</Wix>
