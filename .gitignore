# ============================================================================
#  UpdateAgent - allowlist .gitignore
#
#  Only source, docs, scripts and installer sources are published.
#  Everything is ignored first; the explicit patterns below re-include the
#  files that belong in the repository.
#
#  Local-only files (never uploaded):
#    scripts/github-push.ps1
#    scripts/github-push.bat
#    publish/, artifacts/, bin/, obj/, .vs/
# ============================================================================

# 1) Ignore everything, then let Git traverse directories.
*
!*/

# 2) Re-ignore build output and local deployment folders.
#    A file cannot be re-included when one of its parent folders is ignored.
[Bb]in/
[Oo]bj/
publish/
artifacts/
build/
.vs/
[Dd]ebug/
[Rr]elease/
x64/
x86/
TestResults/
*.user
*.suo
*.log
*.tmp
*.pdb
*.msi
*.cab
*.zip
*.7z
*.rar

# 3) Root files.
!.gitignore
!README.md
!build.bat
!Directory.Build.props
!UpdateAgent.sln
!global.json
!.config/
!.config/dotnet-tools.json

# 4) GitHub Actions workflows.
!.github/
!.github/workflows/
!.github/workflows/*.yml
!.github/workflows/*.yaml

# 5) Documentation.
!docs/
!docs/*.md

# 6) Scripts. The local release helper is intentionally excluded.
!scripts/
!scripts/*.ps1
!scripts/*.bat
!scripts/*.csv
!scripts/*.sample.ini
scripts/github-push.ps1
scripts/github-push.bat

# 7) Source.
!src/
!src/**/*.cs
!src/**/*.csproj
!src/**/*.json
!src/**/*.xaml
!src/**/*.html
!src/**/*.css
!src/**/*.js
!src/**/*.ico
!src/**/*.png
!src/**/*.svg

# 7b) Shared application icons.
!assets/
!assets/icons/
!assets/icons/*.ico

# 8) Tests.
!tests/
!tests/**/*.cs
!tests/**/*.csproj
!tests/**/*.json

# 9) Installer sources (WiX MSI + Inno Setup).
!installer/
!installer/**/*.wxs
!installer/**/*.wixproj
!installer/**/*.wxl
!installer/**/*.iss
!installer/**/*.json
!installer/**/*.rtf

# 10) Removed local experiment: the disconnected Tauri scaffold is not source.
#     The whole folder (including local node_modules, dist, target and gen) stays
#     ignored so a re-created experiment cannot be committed accidentally.
desktop/tauri/

# 11) Final safety net: never upload build output or local deployment folders,
#     even when they live under an included tree such as src/ or installer/.
[Bb]in/
[Oo]bj/
publish/
artifacts/
